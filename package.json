{
  "name": "repositorio-chat",
  "version": "1.0.0",
  "description": "WebSocket chat server with room support and message history",
  "main": "dist/api/index.js",
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "build": "tsc",
    "start": "node dist/api/index.js",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
