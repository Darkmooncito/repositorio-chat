    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0"
  }
}